{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "contexts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ContextAlias"
      },
      "default": {}
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Resource"
        }
      }
    },
    "loopback": {
      "type": [
        "string",
        "null"
      ]
    },
    "ports": {
      "anyOf": [
        {
          "$ref": "#/$defs/GlobalPorts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "groups"
  ],
  "$defs": {
    "ContextAlias": {
      "type": "object",
      "properties": {
        "kubeconfig": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kubeconfig"
      ]
    },
    "GlobalPorts": {
      "type": "object",
      "properties": {
        "mapping": {
          "$ref": "#/$defs/PortMapping"
        }
      },
      "additionalProperties": false,
      "required": [
        "mapping"
      ]
    },
    "PortMapping": {
      "type": "string",
      "enum": [
        "container",
        "service"
      ]
    },
    "PortSpec": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      ]
    },
    "Ports": {
      "type": "object",
      "properties": {
        "local": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortMapping"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote": {
          "$ref": "#/$defs/PortSpec"
        }
      },
      "additionalProperties": false,
      "required": [
        "remote"
      ]
    },
    "Resource": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectorPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "ports": {
          "$ref": "#/$defs/Ports"
        },
        "selector": {
          "$ref": "#/$defs/ResourceSelector"
        }
      },
      "additionalProperties": false,
      "required": [
        "alias",
        "selector",
        "ports"
      ]
    },
    "ResourceSelector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "match": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "type": {
              "type": "string",
              "const": "label"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "match"
          ]
        },
        {
          "type": "object",
          "properties": {
            "match": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "deployment"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "match"
          ]
        },
        {
          "type": "object",
          "properties": {
            "match": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "service"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "match"
          ]
        }
      ]
    },
    "SelectorPolicy": {
      "type": "string",
      "enum": [
        "sticky",
        "roundrobin"
      ]
    }
  }
}